@page "/account/reset-password"
@inject IAuthService AuthService

<PageTitle>Reset password · StudyConnect</PageTitle>

<div class="auth-card">
    @if (_succeeded)
    {
        <div class="auth-success">
            <div class="big-icon">✅</div>
            <h1>Password reset successful</h1>
            <p class="muted">You can now log in with your new password.</p>
            <a class="btn btn-primary" href="account/login">Go to login</a>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(Input.Token))
    {
        <div class="auth-success">
            <div class="big-icon">⚠️</div>
            <h1>Invalid link</h1>
            <p class="muted">This password reset link is missing its token or has been mangled.</p>
            <a class="btn btn-primary" href="account/forgot-password">Request a new link</a>
        </div>
    }
    else
    {
        <h1>Choose a new password</h1>
        <p class="muted">Make it strong, with at least 8 characters with upper and lower case letters, a number and a symbol.</p>

        if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-error">@_error</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset-password" class="form">
            <DataAnnotationsValidator />
            <InputText type="hidden" @bind-Value="Input.Token" />

            <div class="field">
                <label for="password" class="label">New password</label>
                <InputText id="password" class="input" type="password" autocomplete="new-password" data-password-meter="reset-meter" @bind-Value="Input.Password" />
                <ValidationMessage For="() => Input.Password" />
            </div>

            <div class="field">
                <label for="confirm" class="label">Confirm new password</label>
                <InputText id="confirm" class="input" type="password" autocomplete="new-password" @bind-Value="Input.ConfirmPassword" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>

            <div id="reset-meter" class="password-meter" aria-live="polite">
                <div class="meter-track"><div class="meter-fill"></div></div>
                <ul class="meter-rules">
                    <li data-rule="length">At least 8 characters</li>
                    <li data-rule="upper">An uppercase letter</li>
                    <li data-rule="lower">A lowercase letter</li>
                    <li data-rule="digit">A number</li>
                    <li data-rule="special">A special character</li>
                </ul>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Reset password</button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    [SupplyParameterFromForm]
    private ResetPasswordInput Input { get; set; } = new();

    private string? _error;
    private bool _succeeded;

    protected override void OnInitialized()
    {
        // On the first GET the token comes from the e-mail link; on POST it comes from the hidden field.
        if (string.IsNullOrWhiteSpace(Input.Token))
        {
            Input.Token = Token ?? string.Empty;
        }
    }

    private async Task ResetAsync()
    {
        OperationResult result = await AuthService.ResetPasswordAsync(Input.Token, Input.Password, Input.ConfirmPassword);
        if (result.Succeeded)
        {
            _succeeded = true;
        }
        else
        {
            _error = result.Error;
        }
    }
}
