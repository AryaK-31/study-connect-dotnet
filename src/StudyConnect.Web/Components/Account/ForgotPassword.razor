@page "/account/forgot-password"
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Forgot password · StudyConnect</PageTitle>

<div class="auth-card">
    @if (_result is { Accepted: true })
    {
        <div class="auth-success">
            <div class="big-icon">📬</div>
            <h1>Check your email</h1>
            <p class="muted">@_result.Message The link expires in 30 minutes.</p>

            @if (!string.IsNullOrEmpty(_result.DevelopmentResetLink))
            {
                <div class="alert alert-info left">
                    <strong>Development mode:</strong> no mail server is configured, so the e-mail was saved to
                    <code>App_Data/outbox</code>. You can open the reset link directly:
                    <a class="btn btn-secondary btn-sm mt" href="@_result.DevelopmentResetLink">Open reset link</a>
                </div>
            }

            <a class="btn btn-primary" href="account/login">Back to login</a>
        </div>
    }
    else
    {
        <h1>Forgot your password?</h1>
        <p class="muted">Enter your email and we'll send you a link to choose a new one.</p>

        if (_result is { Accepted: false })
        {
            <div class="alert alert-error">@_result.Message</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="forgot-password" class="form">
            <DataAnnotationsValidator />
            <div class="field">
                <label for="email" class="label">Email</label>
                <InputText id="email" class="input" type="email" autocomplete="email" placeholder="you@uts.edu.au" @bind-Value="Input.Email" />
                <ValidationMessage For="() => Input.Email" />
            </div>
            <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
        </EditForm>

        <p class="center small"><a href="account/login">← Back to login</a></p>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private ForgotPasswordInput Input { get; set; } = new();

    private PasswordResetRequestResult? _result;

    private async Task SubmitAsync()
    {
        string resetPageUrl = Navigation.ToAbsoluteUri("account/reset-password").ToString();
        _result = await AuthService.RequestPasswordResetAsync(Input.Email, resetPageUrl);
    }
}
